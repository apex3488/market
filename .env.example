# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=4000
# Neon: postgres://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
# Local dev without Postgres: embedded PGlite file database
DATABASE_URL=pglite:./.data/db
# Public URL of the website (CORS + links in emails)
WEB_URL=http://localhost:3000
# Extra allowed origins, comma separated
CORS_ORIGINS=
# Long random string (openssl rand -base64 48). Required in production.
AUTH_SECRET=
# Store currency (ISO 4217) and courier fee in minor units (1/100). 3000000 = 30 000 UZS
STORE_CURRENCY=UZS
DELIVERY_COURIER_FEE=3000000
# Optional: password-reset emails via Resend (otherwise printed to console in dev)
RESEND_API_KEY=
MAIL_FROM=BAYHAN MARKET <no-reply@example.com>

# ---------- Web (apps/web) ----------
# Where the Next.js server reaches the API (server-side only, never exposed to the browser)
API_INTERNAL_URL=http://localhost:4000
